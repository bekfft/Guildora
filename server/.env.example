PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Ohne DATABASE_URL wird automatisch SQLite unter ./data/guildora.sqlite verwendet.
DATABASE_URL=
SQLITE_PATH=./data/guildora.sqlite

# In Produktion durch lange, unabhängige Zufallswerte ersetzen.
JWT_ACCESS_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh
GITHUB_OWNER=bekfft
GITHUB_REPO=Guildora
# Optional für ein höheres GitHub-API-Limit. Nicht einchecken.
GITHUB_TOKEN=

# Voice über LiveKit. Der API-Secret bleibt ausschließlich auf dem Server.
# In Produktion muss LIVEKIT_URL mit wss:// beginnen.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
